# 서버
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173

# SMPL-X 모델 경로 (재배포 금지 · 각자 다운로드)
SMPLX_MODEL_PATH=./assets/models/smplx/SMPLX_FEMALE.npz

# 체형 12구간 격자 (백엔드와 공유하는 상수)
BODY_GRID_PATH=./assets/grid/body_grid.json

# 사전 계산 GLB 디렉터리
DRAPED_DIR=./assets/draped

# 계측 보정 (정확도 검증 후 생성 · 없어도 동작)
MEASURE_CALIBRATION_PATH=./assets/measure_calibration.json

# 처리 제한
MAX_UPLOAD_SIZE_MB=10
OPTIMIZATION_TIMEOUT_SEC=45

# 서버
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173

# SMPL-X 모델 경로 (재배포 금지 · 각자 다운로드해 배치)
SMPLX_MODEL_PATH=./assets/models/smplx/SMPLX_FEMALE.npz

# 파트 간 계약 파일 — 저장소에 커밋되어 있습니다. 보통 바꿀 일이 없습니다.
BODY_GRID_PATH=./body_grid.json
BIAS_PATH=./bias.json

# 계측 보정 (정확도 검증 후 생성 · 없어도 동작)
MEASURE_CALIBRATION_PATH=./measure_calibration.json

# 산출물
DRAPED_DIR=./assets/draped
AVATAR_DIR=./assets/avatars
# 운영에서는 CDN 주소로 바꾸세요 (예: https://cdn.closr.xxx/avatars)
AVATAR_URL_PREFIX=/static/avatars

# 처리 제한
MAX_UPLOAD_SIZE_MB=10
OPTIMIZATION_TIMEOUT_SEC=45
# CPU 전용이라 2GB 인스턴스에서는 1 을 유지하세요
MAX_CONCURRENT_PIPELINE=1

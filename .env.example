# 서버
PORT=8000
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173

# SMPL-X 모델 경로 (재배포 금지 · 각자 다운로드해 배치)
SMPLX_MODEL_PATH=./assets/models/smplx/SMPLX_FEMALE.npz

# 파트 간 계약 파일 — 저장소에 커밋되어 있습니다. 보통 바꿀 일이 없습니다.
BODY_GRID_PATH=./body_grid.json
BIAS_PATH=./bias.json

# 계측 보정 (정확도 검증 후 생성 · 없어도 동작)
MEASURE_CALIBRATION_PATH=./measure_calibration.json

# 산출물
DRAPED_DIR=./assets/draped
AVATAR_DIR=./assets/avatars
# 운영에서는 CDN 주소로 바꾸세요 (예: https://cdn.closr.xxx/avatars)
AVATAR_URL_PREFIX=/static/avatars

# 처리 제한
MAX_UPLOAD_SIZE_MB=10
OPTIMIZATION_TIMEOUT_SEC=45
# CPU 전용이라 2GB 인스턴스에서는 1 을 유지하세요
MAX_CONCURRENT_PIPELINE=1

# Cloudflare R2 (선택). 다섯 개가 모두 있어야 업로드합니다.
# 하나라도 비면 AI 서버가 직접 서빙합니다(로컬 개발용).
#
# R2 로 옮기는 이유는 HTTPS 입니다. 프론트가 https 인데 GLB 가 http 면
# 브라우저가 요청을 막아 3D 뷰어에 모델이 뜨지 않습니다.
#
# 액세스 키는 저장소에 커밋하지 말고 운영 서버의 .env 에만 두세요.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=closr-assets
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_KEY_PREFIX=avatars/v1

# OpenAI (챗봇). 키가 없으면 챗 엔드포인트만 꺼지고 아바타 생성은 그대로 됩니다.
#
# 키는 저장소에 커밋하지 말고 운영 서버의 .env 에만 두세요.
# 모델은 답변이 2~3문장 120자라 mini 로 충분합니다. 올리면 크레딧이 빨리 줄어듭니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=20
